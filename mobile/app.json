{
  "expo": {
    "name": "Swachham",
    "slug": "swachham",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/swachham-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/swachham-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FFF9",
        "foregroundImage": "./assets/swachham-logo.png"
      },
      "package": "com.anonymous.swachham"
    },
    "web": {
      "favicon": "./assets/swachham-logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Swachham uses the camera to scan garment barcodes during sorting and delivery verification."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/swachham-logo.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "96c48761-101a-412b-81d4-613e3657cf22"
      }
    },
    "owner": "swachhamapps-team"
  }
}
