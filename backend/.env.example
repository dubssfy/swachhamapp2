# Environment Variables — Swachham Backend

# MySQL Database (Aiven)
DATABASE_HOST=your-mysql-host.aivencloud.com
DATABASE_PORT=3306
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=swachham_db
DATABASE_SSL=true

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Client
CLIENT_URL=http://localhost:3000

# Socket
SOCKET_CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMS/OTP Provider (Future)
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=

# Business calendar day for daily order-number sequences (DB runs UTC)
BUSINESS_TZ_OFFSET=+05:30

# --- Meta WhatsApp Cloud API (server-side only, never shipped to the app) ---
WHATSAPP_PHONE_NUMBER_ID=1115163418357009
WHATSAPP_ACCESS_TOKEN=EAAYS3BaH89IBR0v9XD0yr7z2ZBOalPVOj5yd3RAZCwoWFKYfzNsDmhShlfTIUYwK28McEaasGDP3QMZC2kkPZBLTQcy52add6SyXPXn56ym1riOZBS9n97GJwJUD2W5dLFso8iuczDjU6JIy571q69FCtvk75h7ocfTJShUo8YABmIZA4uWWzCYfGnjfgZCWwZDZD
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFECT_TEMPLATE=defective_piece_notification
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=91
